<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuraciones"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!-- Saludo (Hola Nombre) -->
        <TextView
            android:id="@+id/tvHolaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola, Alumno"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Horario Inicio -->
        <EditText
            android:id="@+id/etHorarioInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Horario Inicio (ej. 08:00)"
            android:inputType="time"
            android:padding="16dp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginBottom="16dp" />

        <!-- Horario Fin -->
        <EditText
            android:id="@+id/etHorarioFin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Horario Fin (ej. 10:00)"
            android:inputType="time"
            android:padding="16dp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginBottom="16dp" />

        <!-- Tiempo de Aparición -->
        <EditText
            android:id="@+id/etTiempoAparicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiempo Aparición (minutos)"
            android:inputType="number"
            android:padding="16dp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginBottom="16dp" />

        <!-- Categoría (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="#212121"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerCategoriaConfig"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <!-- Tiempo Examen -->
        <EditText
            android:id="@+id/etTiempoExamen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiempo Examen (minutos)"
            android:inputType="number"
            android:padding="16dp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginBottom="32dp" />

        <!-- Botón Enviar -->
        <Button
            android:id="@+id/btnEnviarConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Enviar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5E4398"
            app:cornerRadius="30dp" />

    </LinearLayout>
</ScrollView>